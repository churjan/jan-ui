{
  "name": "jan-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "registry:check": "shadcn build registry.json --output .registry-check",
    "test": "pnpm --filter www test"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "shadcn": "^4.21.0"
  }
}
